{
  "name": "Dispatcharr VOD Newznab",
  "version": "0.1.1",
  "description": "Expose raw Dispatcharr VOD providers to Sonarr/Radarr as a Newznab indexer and SABnzbd-compatible download client backed by Mustarrd.",
  "author": "matrix2669",
  "fields": [
    {"id":"listen_host","label":"Listen Address","type":"string","default":"0.0.0.0"},
    {"id":"listen_port","label":"Listen Port","type":"number","default":9192},
    {"id":"api_key","label":"Newznab / SAB API Key","type":"string","default":"","help_text":"Generated automatically when the plugin is first enabled."},
    {"id":"mustarrd_url","label":"Mustarrd URL","type":"string","default":"http://mustarrd:4177"},
    {"id":"mustarrd_username","label":"Mustarrd Username","type":"string","default":""},
    {"id":"mustarrd_password","label":"Mustarrd Password","type":"string","input_type":"password","default":""},
    {"id":"mustarrd_account_id","label":"Mustarrd Account ID","type":"number","default":1,"help_text":"Existing Mustarrd account used for ownership/concurrency of external VOD jobs."},
    {"id":"servarr_completed_dir","label":"Completed Directory Seen by Sonarr/Radarr","type":"string","default":"/completed"},
    {"id":"sonarr_category","label":"Sonarr SAB Category","type":"string","default":"sonarr"},
    {"id":"radarr_category","label":"Radarr SAB Category","type":"string","default":"radarr"},
    {"id":"movie_template","label":"Movie Output Template","type":"string","default":"mustarrd/Movies/{title} ({year}) {tmdb_tag}/{release}.{ext}"},
    {"id":"tv_template","label":"TV Output Template","type":"string","default":"mustarrd/TV Shows/{series} ({year}) {tmdb_tag}/Season {season:02d}/{release}.{ext}"},
    {"id":"ffprobe_path","label":"ffprobe Path","type":"string","default":"ffprobe"},
    {"id":"probe_timeout","label":"Probe Timeout (seconds)","type":"number","default":20},
    {"id":"catalog_cache_seconds","label":"Raw Catalog Cache (seconds)","type":"number","default":300},
    {"id":"max_variants","label":"Maximum Variants per Search","type":"number","default":20},
    {"id":"respect_enabled_vod_groups","label":"Respect Enabled Dispatcharr VOD Groups","type":"boolean","default":true}
  ],
  "actions": [
    {"id":"status","label":"Service Status","description":"Show the embedded Newznab/SAB service status and connection information.","button_label":"Check"},
    {"id":"restart","label":"Restart Service","description":"Restart the embedded Newznab/SAB service after settings changes.","button_label":"Restart"},
    {"id":"stop","label":"Stop Service","description":"Stop the embedded Newznab/SAB service.","button_label":"Stop","confirm":{"required":true,"title":"Stop service?","message":"Sonarr and Radarr will be unable to search or download until it is restarted."}}
  ]
}
